# TopoPass Caddy reverse proxy environment example
# Copy to /srv/topopass/env/proxy.env on the EC2 host.
#
# Do not commit the real host file.

# Canonical production hostname and redirect alias. Cloudflare remains the
# authoritative DNS/CDN provider; these values configure the EC2 Caddy origin.
APP_DOMAIN=pcoready.co.uk
WWW_DOMAIN=www.pcoready.co.uk
ACME_EMAIL=admin@pcoready.co.uk

# Managed Supabase remains active. Do not add a SUPABASE_DOMAIN value unless a
# self-hosted gateway is deliberately introduced later.
