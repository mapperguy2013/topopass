{
	email {$ACME_EMAIL:admin@pcoready.co.uk}
}

# PC Ready is the canonical production hostname. Caddy obtains and renews the
# public origin certificate automatically after DNS points to this host and
# ports 80 and 443 are reachable.
{$APP_DOMAIN:pcoready.co.uk} {
	encode zstd gzip

	log {
		output file /var/log/caddy/app-access.log
		format json
	}

	header {
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Frame-Options "DENY"
	}

	reverse_proxy app:3000
}

{$WWW_DOMAIN:www.pcoready.co.uk} {
	redir https://{$APP_DOMAIN:pcoready.co.uk}{uri} permanent
}
